{
  "name": "hello-mlsys-workbench",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts *.ts",
    "format:check": "prettier --check src tests scripts *.ts",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=../.venv/playwright playwright test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@tanstack/react-table": "8.21.3",
    "get-nonce": "1.0.1",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "node": "24.22.3",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
